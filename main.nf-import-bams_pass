process MERGE {

    tag "MERGE on $name"
    publishDir "${params.outDirectory}/${sample.run}/", mode:'copy'

    label "l_cpu"
    label "l_mem"

    input:
    tuple val(name), val(sample), path(bams)

    output:
    tuple val(name), val(sample), path("${name}.bam")

    script:
    """
    source activate samtools
    samtools --version
    samtools merge -O  BAM ${name}.bam ${bams}
    """
}


